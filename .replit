run = "node backend/server.js"
modules = ["nodejs-20"]

[userenv]

[userenv.shared]

[deployment]
deploymentTarget = "vm"
run = ["node", "backend/server.js"]
build = ["bash", "-c", "cd frontend && npm install && npm run build"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && PORT=3000 npm start"
